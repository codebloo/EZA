{% comment %}
  Video Carousel Block Schema
  Parent block that contains video-carousel-item child blocks
{% endcomment %}

{% comment %}
  Video Carousel Block (Parent)
  A horizontal drag carousel for 9:16 vertical videos (TikTok/IG style)
  This is a BLOCK that goes inside a section and accepts child video-carousel-item blocks
  
{% endcomment %}

{{ 'eza-ugc-video-carousel.css' | asset_url | stylesheet_tag }}

<div class="video-carousel" data-video-carousel {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="video-carousel__heading">{{ block.settings.heading }}</h2>
  {% endif %}
  
  <div class="video-carousel__viewport" data-carousel-viewport>
    <div class="video-carousel__container" data-carousel-container>
       {% content_for 'blocks' %}
    </div>
  </div>
</div>

<script src="https://unpkg.com/embla-carousel/embla-carousel.umd.js" defer></script>
<script src="{{ 'eza-ugc-video-carousel.js' | asset_url }}" defer></script>

<style>
  .video-carousel {
    --video-width-desktop: {{ block.settings.desktop_video_width }}px;
    --video-width-mobile: {{ block.settings.mobile_video_width }}px;
    --desktop-carousel-gap: {{ block.settings.desktop-gap }}px;
    --mobile-carousel-gap: {{ block.settings.mobile-gap }}px;
  }
</style>


{% schema %}
{
  "name": "EZA UGC Video Carousel",
  "tag": "div",
  "class": "video-carousel-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "EZ-A in the wild"
    },
    {
      "type": "range",
      "id": "desktop_video_width",
      "min": 200,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Desktop video width",
      "default": 280
    },
{
  "type": "range",
  "id": "mobile_video_width",
  "min": 100,
  "max": 200,
  "step": 5,
  "unit": "px",
  "label": "Mobile video width",
  "default": 200
},
    {
      "type": "range",
      "id": "desktop-gap",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "label": "Gap between videos (Desktop)",
      "default": 24
    },
       {
      "type": "range",
      "id": "mobile-gap",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "label": "Gap between videos (mobie)",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "eza-ugc-carousel-item"
    }
  ],
  "presets": [
    {
      "name": "EZA UGC Video Carousel",
      "blocks": [
        { "type": "eza-ugc-carousel-item" },
        { "type": "eza-ugc-carousel-item" },
        { "type": "eza-ugc-carousel-item" },
        { "type": "eza-ugc-carousel-item" }
      ]
    }
  ]
}
{% endschema %}


