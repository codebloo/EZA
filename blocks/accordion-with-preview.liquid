{% comment %}
  Block: Accordion item (inline reveal)
  -------------------------------------
  Stackable accordion row that keeps body content inline with the
  heading. The body is split into a "head" (always visible) and a
  "tail" (revealed on expand) so the text reads as one continuous
  paragraph rather than popping to a separate content area.

  Animation uses the grid-template-rows 0fr → 1fr trick, which
  smoothly transitions to natural content height — no JS measuring,
  no max-height guessing.

  The head/tail boundary snaps to a word break so the truncation
  point reads cleanly in both states (no "ADJUSTI" / "NG" cuts).
{% endcomment %}

{%- liquid
  assign char_limit = block.settings.char_limit
  assign body = block.settings.body
  assign body_plain = body | strip_html | strip_newlines | strip
  assign body_size = body_plain.size
  assign is_expandable = false
  assign head = ''
  assign tail = ''

  if body_size > char_limit
    comment
      Build the head word-by-word so the head/tail boundary lands at
      a clean word break. Stop adding words once the next one would
      push us past char_limit.
    endcomment
    assign words = body_plain | split: ' '
    for word in words
      if head == ''
        assign tentative = word
      else
        assign tentative = head | append: ' ' | append: word
      endif
      if tentative.size > char_limit
        break
      endif
      assign head = tentative
    endfor

    if head == ''
      comment 
      First word alone is longer than char_limit — fall back to it. 
      endcomment
      assign head = words.first
    endif

    assign tail = body_plain | remove_first: head
    if tail.size > 0
      assign is_expandable = true
    endif
  endif

  assign sizes_attr = block.settings.icon_size | append: 'px'
-%}

<accordion-item
  class="accordion-item"
  {{ block.shopify_attributes }}
  style="--ai-heading: {{ block.settings.heading_color }}; --ai-text: {{ block.settings.text_color }}; --ai-chevron: {{ block.settings.chevron_color }}; --ai-divider: {{ block.settings.divider_color }}; --ai-icon-size: {{ block.settings.icon_size }}px;"
>
  {%- if is_expandable -%}
    <button
      type="button"
      class="accordion-item__row"
      aria-expanded="{% if block.settings.default_open %}true{% else %}false{% endif %}"
    >
      {%- if block.settings.icon != blank -%}
        <span class="accordion-item__icon">
          {{ block.settings.icon | image_url: width: 240 | image_tag:
            loading: 'lazy',
            widths: '60, 120, 180, 240',
            sizes: sizes_attr,
            alt: block.settings.icon.alt | default: block.settings.heading | escape
          }}
        </span>
      {%- else -%}
        <span class="accordion-item__icon accordion-item__icon--empty" aria-hidden="true"></span>
      {%- endif -%}

      <span class="accordion-item__text">
        {%- if block.settings.heading != blank -%}
          <strong class="accordion-item__heading">{{ block.settings.heading }}</strong>
        {%- endif -%}
        <span class="accordion-item__head">{{ head }}</span><span class="accordion-item__ellipsis" aria-hidden="true">…</span><span class="accordion-item__tail-wrap"><span class="accordion-item__tail">{{ tail }}</span></span>
      </span>

      <span class="accordion-item__chevron" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.25">
          <circle cx="12" cy="12" r="11" />
          <path d="M8 11l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </button>
  {%- else -%}
    <div class="accordion-item__row accordion-item__row--static">
      {%- if block.settings.icon != blank -%}
        <span class="accordion-item__icon">
          {{ block.settings.icon | image_url: width: 240 | image_tag:
            loading: 'lazy',
            widths: '60, 120, 180, 240',
            sizes: sizes_attr,
            alt: block.settings.icon.alt | default: block.settings.heading | escape
          }}
        </span>
      {%- else -%}
        <span class="accordion-item__icon accordion-item__icon--empty" aria-hidden="true"></span>
      {%- endif -%}

      <span class="accordion-item__text">
        {%- if block.settings.heading != blank -%}
          <strong class="accordion-item__heading">{{ block.settings.heading }}</strong>
        {%- endif -%}
        <span class="accordion-item__head">{{ body_plain }}</span>
      </span>
    </div>
  {%- endif -%}
</accordion-item>

{% style %}
  .accordion-item {
    display: block;
    border-top: 1px solid var(--ai-divider);
  }
  .accordion-item:last-of-type {
    border-bottom: 1px solid var(--ai-divider);
  }
  .accordion-item__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: start;
    width: 100%;
    padding: 1.25rem 0;
    background: none;
    border: 0;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .accordion-item__row--static {
    cursor: default;
  }
  .accordion-item__row:focus-visible {
    outline: 2px solid var(--ai-chevron);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .accordion-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .accordion-item__icon img {
    display: block;
    width: var(--ai-icon-size);
    height: var(--ai-icon-size);
    object-fit: contain;
  }
  .accordion-item__icon--empty {
    width: 0;
  }
  .accordion-item__text {
    color: var(--ai-text);
    line-height: 1.4;
  }
  .accordion-item__heading {
    color: var(--ai-heading);
    font-weight: 700;
  }
  /* Space between heading and head text without relying on markup whitespace */
  .accordion-item__heading + .accordion-item__head::before {
    content: ' ';
    white-space: pre;
  }
  /* Tail reveal: 0fr → 1fr smoothly grows to natural content height.
     The inner element clips overflow so text doesn't escape mid-transition. */
  .accordion-item__tail-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 350ms ease-out;
  }
  .accordion-item__tail {
    overflow: hidden;
    min-height: 0;
  }
  .accordion-item__row[aria-expanded="true"] .accordion-item__ellipsis {
    display: none;
  }
  .accordion-item__row[aria-expanded="true"] .accordion-item__tail-wrap {
    grid-template-rows: 1fr;
  }
  .accordion-item__chevron {
    display: inline-flex;
    color: var(--ai-chevron);
    transition: transform 250ms ease;
    margin-top: 0.15em;
  }
  .accordion-item__row[aria-expanded="true"] .accordion-item__chevron {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .accordion-item__tail-wrap,
    .accordion-item__chevron {
      transition: none;
    }
  }
{% endstyle %}

<script>
  if (!customElements.get('accordion-item')) {
    customElements.define(
      'accordion-item',
      class extends HTMLElement {
        connectedCallback() {
          /*
            Event delegation on the host element. Attaching directly to
            the inner button breaks for the 2nd+ instance: when the
            custom element is already defined, connectedCallback fires
            during parsing before child nodes exist, so querySelector
            returns null. Listening on `this` works because the host
            element exists at connect time, and we resolve the trigger
            at click time when the children are guaranteed to be in DOM.
          */
          this.addEventListener('click', (event) => {
            const trigger = event.target.closest('.accordion-item__row[aria-expanded]');
            if (!trigger || !this.contains(trigger)) return;
            const isOpen = trigger.getAttribute('aria-expanded') === 'true';
            trigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
          });
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "Accordion item",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Bold heading",
      "info": "Shown in bold next to the icon. End with a period if you want it to flow into the preview text.",
      "default": "Take it easy. Start with one capsule."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Content",
      "default": "<p>Wait 30 minutes before adjusting. Stack effects build subtly until they don't.</p>"
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "range",
      "id": "char_limit",
      "label": "Preview character limit",
      "info": "Approximate length of the preview text shown next to the heading. Snaps to the nearest word boundary so cuts read cleanly.",
      "min": 20,
      "max": 200,
      "step": 5,
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "default_open",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text colour",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "chevron_color",
      "label": "Chevron colour",
      "default": "#9CA3AF"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider colour",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Accordion item"
    }
  ]
}
{% endschema %}
