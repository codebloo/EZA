{% comment %}
  Block: Accordion item (line-clamp version)
  ------------------------------------------
  Heading and body render as a single inline text flow inside one
  wrapper. The browser handles visual truncation via -webkit-line-clamp
  (multi-line equivalent of text-overflow: ellipsis), so there's no
  manual head/tail split and no mid-word breaks.

  Animation: max-height transition gives the slide. JS coordinates
  the line-clamp/height swap so both expand AND collapse stay smooth
  (without coordination, the line-clamp re-application snaps content
  height down before max-height can transition on collapse).
{% endcomment %}

{%- liquid
  assign body = block.settings.body
  assign body_plain = body | strip_html | strip_newlines | strip
  assign sizes_attr = block.settings.icon_size | append: 'px'
  assign initially_open = block.settings.default_open
-%}

<accordion-item
  class="accordion-item"
  {{ block.shopify_attributes }}
  style="--ai-heading: {{ block.settings.heading_color }}; --ai-text: {{ block.settings.text_color }}; --ai-chevron: {{ block.settings.chevron_color }}; --ai-divider: {{ block.settings.divider_color }}; --ai-icon-size: {{ block.settings.icon_size }}px; --ai-preview-lines: {{ block.settings.preview_lines }};"
>
  <button
    type="button"
    class="accordion-item__row"
    aria-expanded="{% if initially_open %}true{% else %}false{% endif %}"
  >
    {%- if block.settings.icon != blank -%}
      <span class="accordion-item__icon">
        {{ block.settings.icon | image_url: width: 240 | image_tag:
          loading: 'lazy',
          widths: '60, 120, 180, 240',
          sizes: sizes_attr,
          alt: block.settings.icon.alt | default: block.settings.heading | escape
        }}
      </span>
    {%- else -%}
      <span class="accordion-item__icon accordion-item__icon--empty" aria-hidden="true"></span>
    {%- endif -%}

    <span class="accordion-item__body-wrap{% unless initially_open %} is-clamped{% endunless %}">
      {%- if block.settings.heading != blank -%}
        <strong class="accordion-item__heading">{{ block.settings.heading }}</strong>
      {%- endif %}
      <span class="accordion-item__body">{{ body_plain }}</span>
    </span>

    <span class="accordion-item__chevron" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.25">
        <circle cx="12" cy="12" r="11" />
        <path d="M8 11l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </button>
</accordion-item>

{% style %}
  .accordion-item {
    display: block;
    border-top: 1px solid var(--ai-divider);
  }
  .accordion-item:last-of-type {
    border-bottom: 1px solid var(--ai-divider);
  }
  .accordion-item__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: start;
    width: 100%;
    padding: 1.25rem 0;
    background: none;
    border: 0;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .accordion-item__row:focus-visible {
    outline: 2px solid var(--ai-chevron);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .accordion-item__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .accordion-item__icon img {
    display: block;
    width: var(--ai-icon-size);
    height: var(--ai-icon-size);
    object-fit: contain;
  }
  .accordion-item__icon--empty {
    width: 0;
  }
  /* Single inline text wrapper holding heading + body. The browser handles
     wrapping and ellipsis. Adding .is-clamped applies the line-clamp;
     removing it lets the content flow to natural height. */
  .accordion-item__body-wrap {
    display: block;
    color: var(--ai-text);
    line-height: 1.4;
    overflow: hidden;
    transition: max-height 350ms ease;
  }
  .accordion-item__body-wrap.is-clamped {
    display: -webkit-box;
    -webkit-line-clamp: var(--ai-preview-lines, 2);
    -webkit-box-orient: vertical;
  }
  .accordion-item__heading {
    color: var(--ai-heading);
    font-weight: 700;
  }
  .accordion-item__chevron {
    display: inline-flex;
    color: var(--ai-chevron);
    transition: transform 250ms ease;
    margin-top: 0.15em;
  }
  .accordion-item__row[aria-expanded="true"] .accordion-item__chevron {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .accordion-item__body-wrap,
    .accordion-item__chevron {
      transition: none;
    }
  }
{% endstyle %}

<script>
  if (!customElements.get('accordion-item')) {
    customElements.define(
      'accordion-item',
      class extends HTMLElement {
        connectedCallback() {
          /* Event delegation on host so the listener attaches at connect
             time even though child nodes may not yet be parsed for the
             2nd+ instance (custom-element constructor timing quirk). */
          this.addEventListener('click', this._onClick.bind(this));
        }

        _onClick(event) {
          const trigger = event.target.closest('.accordion-item__row[aria-expanded]');
          if (!trigger || !this.contains(trigger)) return;
          const wrap = this.querySelector('.accordion-item__body-wrap');
          if (!wrap) return;
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          if (isOpen) this._collapse(wrap, trigger);
          else this._expand(wrap, trigger);
        }

        _expand(wrap, trigger) {
          /* Measure clamped height, then unclamp and measure natural.
             Anchor max-height at the clamped value, then transition up
             to natural. Content stays unclamped throughout the animation
             so the wrapper has the correct natural height to grow into. */
          const startHeight = wrap.offsetHeight;
          wrap.classList.remove('is-clamped');
          const endHeight = wrap.scrollHeight;

          wrap.style.maxHeight = startHeight + 'px';
          void wrap.offsetHeight; // force reflow so the next change transitions
          wrap.style.maxHeight = endHeight + 'px';
          trigger.setAttribute('aria-expanded', 'true');

          this._afterTransition(wrap, () => {
            wrap.style.maxHeight = '';
          });
        }

        _collapse(wrap, trigger) {
          /* Measure natural, briefly apply clamp to read the target
             collapsed height, then unclamp again before animating. The
             clamp is re-applied only after the transition finishes,
             which is what avoids the snap-collapse. */
          const startHeight = wrap.scrollHeight;
          wrap.classList.add('is-clamped');
          const endHeight = wrap.scrollHeight;
          wrap.classList.remove('is-clamped');

          wrap.style.maxHeight = startHeight + 'px';
          void wrap.offsetHeight;
          wrap.style.maxHeight = endHeight + 'px';
          trigger.setAttribute('aria-expanded', 'false');

          this._afterTransition(wrap, () => {
            wrap.classList.add('is-clamped');
            wrap.style.maxHeight = '';
          });
        }

        _afterTransition(wrap, fn) {
          const onEnd = (event) => {
            if (event.target !== wrap || event.propertyName !== 'max-height') return;
            wrap.removeEventListener('transitionend', onEnd);
            fn();
          };
          wrap.addEventListener('transitionend', onEnd);
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "Accordion item",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Bold heading",
      "info": "Shown in bold next to the icon. The body continues inline from here.",
      "default": "Take it easy. Start with one capsule."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Content",
      "default": "<p>Wait 30 minutes before adjusting. Stack effects build subtly until they don't.</p>"
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "range",
      "id": "preview_lines",
      "label": "Preview lines",
      "info": "How many lines of text show before the row is expanded. The browser handles word-boundary truncation and ellipsis automatically.",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "default_open",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text colour",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "chevron_color",
      "label": "Chevron colour",
      "default": "#9CA3AF"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider colour",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Accordion item"
    }
  ]
}
{% endschema %}
