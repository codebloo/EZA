
<div class="gallery-image" style="background: linear-gradient(180deg, rgba(0, 0, 0, 0.00) 43.83%, rgba(0, 0, 0, 0.90) 100%), url({{ block.settings.image | img_url:'master' }}) lightgray 50% / cover no-repeat;;">
 
  <div class="gallery-image-title">{{ block.settings.title }}</div>
  <div class="gallery-image-text">{{ block.settings.text }}</div>
  <span class="gradient"></span>
</div>


{% schema %}
{
  "name": "Gallery Image",
  "settings": [ 
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"},
     
    {
      "type": "text",
      "id": "title",
      "label": "Title"},
          {
      "type": "textarea",
      "id": "text",
      "label": "Text"}
 
  ],
  "presets": [
    {
      "name": "Gallery Image",
    }
  ]
}
{% endschema %}
