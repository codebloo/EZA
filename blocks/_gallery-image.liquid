
<div class="gallery-image gallery-image-{% increment variable %}" style="background-image:url({{ block.settings.image | img_url:'master' }});">
        <div class="gallery-image-title">{{ block.settings.title }}</div>
         <div class="gallery-image-text">{{ block.settings.text }}</div>
</div>



{% schema %}
{
  "name": "Gallery Image",
  "settings": [ 
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"},
     
    {
      "type": "text",
      "id": "title",
      "label": "Title"},
          {
      "type": "textarea",
      "id": "text",
      "label": "Text"}
 
  ],
  "presets": [
    {
      "name": "Gallery Image",
    }
  ]
}
{% endschema %}
