
<div class="timeline">
  <div class="timeline-pill">{{ block.settings.title }}</div>
  <div class="timeline-text">{{ block.settings.text }}</div>
</div>


{% schema %}
{
  "name": "Play Step",
  "settings": [ 

     
    {
      "type": "text",
      "id": "title",
      "label": "Time"},
          {
      "type": "textarea",
      "id": "text",
      "label": "Text"}
 
  ],
  "presets": [
    {
      "name": "Play Step",
    }
  ]
}
{% endschema %}
