
<div class="timeline-step">
  <div class="timeline-pill"><span>{{ block.settings.title }}</span></div>
  <div class="timeline-text">{{ block.settings.text }}</div>
</div>


{% schema %}
{
  "name": "Play Step",
  "settings": [ 
    {
      "type": "image_picker",
      "id": "image",
      "label": "Icon"},
     
    {
      "type": "text",
      "id": "title",
      "label": "Time"},
          {
      "type": "textarea",
      "id": "text",
      "label": "Text"}
 
  ],
  "presets": [
    {
      "name": "Play Step",
    }
  ]
}
{% endschema %}
