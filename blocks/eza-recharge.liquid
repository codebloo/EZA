
{%- liquid
  assign target_product = section.settings.product | default: product
-%}
{% render 'eza-recharge',
   product:    target_product,
   section_id: section.id,
   block:      block %}

{% schema %}
{
  "name": "EZA ReCharge Widget",
  "class": "recharge-block",
  "presets": [
    {
      "name": "EZAReCharge Widget",
      "category": "EZA",
    
    }
    
  ],

  "settings": [
    {
  "type": "text",
"id": "one_time_title",
"label": "One time title",
"default":"One-time Purchase"},
    {
  "type": "text",
"id": "subscrition_title",
"label": "Subscription title",
"default":"Subscribe &amp; Save"},
{
  "type": "number",
  "id": "units_per_pack",
  "label": "Units per pack",
  "default": 12,
  "info": "How many capsules/units in a single pack. Multiplied by the leading number in the variant title (e.g. '2-Pack' = 2 × 12 = 24)."
},
{
  "type": "text",
  "id": "unit_label",
  "label": "Unit label",
  "default": "capsule",
  "info": "Singular noun for one unit, e.g. 'capsule', 'serving', 'tablet'."
},
    {
  "type": "text",
"id": "subscrition_benefdits",
"label": "Subscription Benefits",
"default":"Free Shipping · Cancel Anytime · "},
{
  "type": "checkbox",
  "id": "redirect_to_checkout",
  "label": "Skip cart and go straight to checkout",
  "default": false
}

]
}
{% endschema %}
