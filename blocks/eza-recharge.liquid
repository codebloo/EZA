
{%- liquid
  assign target_product = section.settings.product | default: product
-%}
{% render 'eza-recharge',
   product:    target_product,
   section_id: section.id,
   block:      block %}

{% schema %}
{
  "name": "EZA ReCharge Widget",
  "class": "recharge-block",
  "presets": [
    {
      "name": "EZAReCharge Widget",
      "category": "EZA",
    
    }
    
  ],

  "settings": [
    {
  "type": "text",
"id": "one_time_title",
"label": "One time title",
"default":"One-time Purchase"},
    {
  "type": "text",
"id": "subscrition_title",
"label": "Subscription title",
"default":"Subscribe &amp; Save"},
    {
  "type": "text",
"id": "subscrition_benefdits",
"label": "Subscription Benefits",
"default":"Free Shipping · Cancel Anytime · "},

]
}
{% endschema %}
