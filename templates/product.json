    "cb_pdp_quality_QcNFF9": {
      "type": "cb-pdp-quality",
      "blocks": {
        "quality_4hJHmW": {
          "type": "quality",
          "settings": {
            "image": "shopify://shop_images/icon-qa-atom.svg",
            "title": "Our PhD Master Formulator",
            "text": "Brian Dixon, PhD has a doctorate in molecular biology and 25 years experience formulating supplements. No celebrity co-sign. Just the guy who actually knows what he’s doing."
          }
        },
        "quality_hqYVxF": {
          "type": "quality",
          "settings": {
            "image": "shopify://shop_images/icon-qa-beaker.svg",
            "title": "Every Lot is 3rd-party Tested",
            "text": "Potency, adulterants, heavy metals, all tested on the finished product. Not just the raw ingredients going in. Most brands stop at raw materials and call it a day... But we go the extra mile."
          }
        },
        "quality_9Lbqnb": {
          "type": "quality",
          "settings": {
            "image": "shopify://shop_images/icon-qa-certified.svg",
            "title": "GMP + NSF Certified Facility",
            "text": "EZ-A is manufactured in a NSF-certified, FDA-registered, cGMP compliant facility. The supplement bar has been too low. That’s why we set a much higher one."
          }
        },
        "quality_C8VBPY": {
          "type": "quality",
          "settings": {
            "image": "shopify://shop_images/icon-qa-pill.svg",
            "title": "Methylated B Vitamins",
            "text": "The form your body can actually absorb and use. Most brands skip it because it costs more to source. Up to 60% of people can’t fully process the cheaper version. Do the math."
          }
        },
        "quality_rJHXeg": {
          "type": "quality",
          "settings": {
            "image": "shopify://shop_images/icon-qa-heart.svg",
            "title": "Love EZ-A or Your Money Back",
            "text": "We’re so confident you’ll love EZ-A, your first baggie’s free if you don’t. And that offer has stood since we hung out our e-commerce shingle."
          }
        }
      },
