      "blocks": {
        "testimonial_rAMCqm": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“I was skeptical at first, but after EZ-A hit for the first time I was like OMG! Where have you been all my life? I really wish I had this when I was still in college, I feel like I could have been at the top of my class.”</p>",
            "image": "shopify://shop_images/testimonial-author-1.png",
            "author": "Nathalie B.",
            "author_info": "Event planner"
          }
        },
        "testimonial_T7AweB": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“At the risk of sounding like a fanboy, EZ-A has become an important part to my success. I have some in my bag because I never know when I might need an extra edge. It really does make me react faster.”</p>",
            "image": "shopify://shop_images/testimonial-author-2.png",
            "author": "Luke W.",
            "author_info": "Student & Gamer"
          }
        },
        "testimonial_DtUeyk": {
          "type": "testimonial",
          "settings": {
            "icon": "5-stars",
            "testimonial": "<p>“I have to stay up all night from time to time (sometimes it’s even for fun), and EZ-A makes it all possible. In the clutch, I hope I always have some in my pocket—my gf needs to stop stealing my stash.”</p>",
            "image": "shopify://shop_images/testimonial-author-3.png",
            "author": "Elliot S.",
            "author_info": "Entrepreneur & coder"
          }
        }
      },
