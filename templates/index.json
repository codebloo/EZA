                "text_AGfdNq": {
                  "type": "text",
                  "name": "t:names.heading",
                  "settings": {
                    "text": "<h2><strong>Other nootropics require faith. EZ-A requires about 20 minutes.</strong></h2>",
                    "width": "100%",
                    "max_width": "none",
                    "alignment": "left",
                    "type_preset": "h1",
