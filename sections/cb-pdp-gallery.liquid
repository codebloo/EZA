<section class="pdp-gallery">
    <div class="section section--page-width">
        <div class="all-images">
   {% increment galleryimage %}
  {% content_for 'blocks' %}
  </div>
</div>
</section>
{% schema %}
{
  "name": "EZ-A PDP Gallery",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_gallery-image"
    },
  ],
  "disabled_on": {
    "groups": ["header"]
  },
    "presets": [
    {
      "name": "PDP Gallery",
    }
  ]
}
{% endschema %}
