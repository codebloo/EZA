<div class="pdp-gallery">
    {%  assign count = 1 %}
    {% for block in section.blocks %}
         {% assign count = count | plus: 1 %}
{% render '_gallery-image' %}
{% endfor %}
</div>

{% schema %}
{
  "name": "EZ-A PDP Gallery",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_gallery-image"
    },
  ],
  "disabled_on": {
    "groups": ["header"]
  },
    "presets": [
    {
      "name": "PDP Gallery",
    }
  ]
}
{% endschema %}
