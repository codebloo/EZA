<section class="pdp-play-by-play">
    <div class="section section--page-width">
         <h2 class="play-title">{{ section.settings.title }}</h2>
        <div class="play-all-steps">
            <div class="play-step-list">{% content_for 'blocks' %}</div><
                /div>
</div>
</section>
{% schema %}
{
  "name": "EZ-A PDP PlayByPlay",
  "class": "section-wrapper",
  "settings": [{
"type": "text",
"id":"title",
"label": "Title"}],
  "blocks": [
    {
      "type": "_play-step"
    },
  ],
  "disabled_on": {
    "groups": ["header"]
  },
    "presets": [
    {
      "name": "PDP Play by Play",
    }
  ]
}
{% endschema %}
