<section class="pdp-timeline">
    <div class="section section--page-width">
       
        <div class="timeline-all-steps">
              <h2 class="timeline-title">{{ section.settings.title }}</h2>
            <div class="timeline-list">{% content_for 'blocks' %}</div>
        </div>
</div>
</section>
{% schema %}
{
  "name": "EZ-A PDP PlayByPlay",
  "class": "section-wrapper",
  "settings": [{
"type": "text",
"id":"title",
"label": "Title"}],
  "blocks": [
    {
      "type": "_play-step"
    },
  ],
  "disabled_on": {
    "groups": ["header"]
  },
    "presets": [
    {
      "name": "PDP Play by Play",
    }
  ]
}
{% endschema %}
