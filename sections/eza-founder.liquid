<section class="eza-founder">
    <div class="founder-gradient">
    <div class="founder-section-inner">
<div class="founder-wrap">
        <div class="founder">
            {{ section.settings.image_mob | image_url: width: 1000 | image_tag: class: 'mobile-founder-image' }}
             {{ section.settings.image | image_url: width: 1000 | image_tag: class: 'desktop-founder-image' }}
            <div class="founder-values">
            <span class="founder-name">{{ section.settings.founder_name }}</span>
            <span class="founder-title">{{ section.settings.founder_title }}</span>
            </div>
        </div>

        <div class="founder-content">
            <div class="content-eyebrow">{{ section.settings.eyebrow }}</div>
            <div class="content-title">{{ section.settings.title }}</div>
            <div class="content-text">{{ section.settings.text }}</div>
            <div class="content-attribution">{{ section.settings.attribution }}</div>
            <a href="{{ section.settings.link }}" class="button content-button">{{ section.settings.button }}
                {% render 'eza-button-arrow', arrow_color: yellow %}
            </a>
        </div>
</div>
    </div>
    </div>
</section>

<style>

.founder{
position:relative;
}
.founder-values{
    bottom:61px;
    left:24px;
    position:absolute;
    text-align:left;
    width:100%;
}
.founder-name,
.founder-title{
    color:var(--yellow);
    display:block;
    font-size:17px;
    line-height:21px;}

.founder-name{font-weight:700;}
.founder-title{font-weight:400;}

.founder-content{
    background-color:var(--black);
display:flex;
flex-direction:column;
gap:8px;
padding: 0 24px 48px;}

.content-eyebrow{
color: #D3D3D3;
font-size: 16px;
font-weight: 700;
line-height: 1.1;}

.content-title{
color: var(--yellow);
font-size: 24px;
font-weight: 700;
line-height: 1.1;}

.content-text{
    border-left:4px solid var(--yellow);
color:  #F1F1F1;
font-size: 16px;
font-weight: 400;
line-height: 21px; 
padding-left:8px;}

.content-attribution{
color: var(--yellow);
font-size: 14px;
font-weight: 700;
line-height: 21px; 
margin-bottom:32px;}

.content-button{
    align-items: center;
    border-radius: 8px;
border: 2px solid  rgba(255, 242, 0, 0.50);
color:var(--white);
display: flex;
gap: 10px;
height: 48px;
justify-content: center;
padding: 12px 24px;
width: 327px;
}

.mobile-founder-image{
    max-width:100%;
    width:100%;}
.desktop-founder-image{display:none;}

@media (min-width:750px){
.eza-founder{background:  rgba(255, 242, 0, 0.50);}
.founder-gradient{ background: linear-gradient(180deg, rgba(0, 0, 0, 0.00) 20.19%, rgba(0, 0, 0, 0.80) 100%);}
.founder{
    align-items:end;
    background-size:100% auto;
    color: var(--white);
    display:flex;
    justify-content:center;
    padding: 0;
    width:587px;
}
.desktop-founder-image{display:block;}
.founder-section-inner{
    margin:0 auto;
    max-width:100%;
    width:1080px;}
.founder-wrap{
    display:flex;
    justify-content:space-between;
    padding:  0; }
.founder-content{
    align-items: flex-start;
    align-self: stretch;
border-radius:16px;
display: flex;
flex-direction: column;
height: fit-content;
margin-bottom:70px;
max-width:100%;
padding: 32px 24px;
width:375px;}

.mobile-founder-image{display:none;}

.content-eyebrow{}
.content-title{font-size: 36px;}
.content-text{}

}
</style>

{% schema %}
{
  "name": "EZ-A Founder",
  "class": "section-wrapper",
  "settings": [
      {
    "type": "header",
"content": "Image"},
        {
      "type": "image_picker",
      "id": "image",
      "label": "Image"},
         {
      "type": "image_picker",
      "id": "image_mob",
      "label": "Mobile Image"},
         {
      "type": "text",
      "id": "founder_name",
      "label": "founder_name"},
         {
      "type": "text",
      "id": "founder_title",
      "label": "Founder Title"},
      {
    "type": "header",
"content": "Content"},
      {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"},
        {
      "type": "textarea",
      "id": "title",
      "label": "Title"},
     
          {
      "type": "richtext",
      "id": "text",
      "label": "Text"},
         {
      "type": "text",
      "id": "attribution",
      "label": "Attribution"},
        {
      "type": "text",
      "id": "button",
      "label": "Button text"},
        {
      "type": "url",
      "id": "link",
      "label": "Link"}

  ],
  "disabled_on": {
    "groups": ["header"]
  },
    "presets": [
    {
      "name": "EZ-A Founder",
    }
  ]
}
{% endschema %}
