<script>
  class DragCarousel {
  constructor(container, options = {}) {
    this.container = container;
    this.slides = [...container.children];
    this.options = {
      snapToSlide: true,
      momentum: 0.92,
      dragMultiplier: 1,
      ...options
    };
    
    this.isDragging = false;
    this.startX = 0;
    this.scrollLeft = 0;
    this.velocity = 0;
    this.rafId = null;
    
    this.init();
  }

  init() {
    // Mouse events
    this.container.addEventListener('mousedown', (e) => this.startDrag(e));
    window.addEventListener('mousemove', (e) => this.drag(e));
    window.addEventListener('mouseup', () => this.endDrag());
    
    // Touch events
    this.container.addEventListener('touchstart', (e) => this.startDrag(e), { passive: true });
    this.container.addEventListener('touchmove', (e) => this.drag(e), { passive: true });
    this.container.addEventListener('touchend', () => this.endDrag());
    
    // Prevent drag on links/images
    this.container.querySelectorAll('a, img').forEach(el => {
      el.addEventListener('dragstart', (e) => e.preventDefault());
    });
    
    // Style setup
    this.container.style.cursor = 'grab';
    this.container.style.overflow = 'hidden';
  }

  getX(e) {
    return e.type.includes('mouse') ? e.pageX : e.touches[0].pageX;
  }

  startDrag(e) {
    this.isDragging = true;
    this.startX = this.getX(e);
    this.scrollLeft = this.container.scrollLeft;
    this.prevX = this.startX;
    this.velocity = 0;
    this.container.style.cursor = 'grabbing';
    cancelAnimationFrame(this.rafId);
  }

  drag(e) {
    if (!this.isDragging) return;
    
    const x = this.getX(e);
    const delta = (x - this.startX) * this.options.dragMultiplier;
    this.velocity = this.prevX - x;
    this.prevX = x;
    
    this.container.scrollLeft = this.scrollLeft - delta;
    this.onScroll?.();
  }

  endDrag() {
    if (!this.isDragging) return;
    this.isDragging = false;
    this.container.style.cursor = 'grab';
    
    // Apply momentum
    this.applyMomentum();
  }

  applyMomentum() {
    if (Math.abs(this.velocity) > 0.5) {
      this.container.scrollLeft += this.velocity;
      this.velocity *= this.options.momentum;
      this.onScroll?.();
      this.rafId = requestAnimationFrame(() => this.applyMomentum());
    } else if (this.options.snapToSlide) {
      this.snapToNearest();
    }
  }

  snapToNearest() {
    const slideWidth = this.slides[0]?.offsetWidth || 0;
    const gap = parseInt(getComputedStyle(this.container).gap) || 0;
    const snapUnit = slideWidth + gap;
    const target = Math.round(this.container.scrollLeft / snapUnit) * snapUnit;
    
    this.container.scrollTo({ left: target, behavior: 'smooth' });
    setTimeout(() => this.onScroll?.(), 300);
  }

  // Progress: 0 to 1
  get progress() {
    const max = this.container.scrollWidth - this.container.clientWidth;
    return max > 0 ? this.container.scrollLeft / max : 0;
  }
}
document.addEventListener('DOMContentLoaded', () => {
  const slider = document.querySelector('#Testimonials-{{ section.id }}');
  const progressBar = document.querySelector('.testimonial-progressbar__bar');
  const slideCount = {{ section.blocks.size }};
  
  if (slider) {
    const carousel = new DragCarousel(slider, {
      snapToSlide: true,
      momentum: 0.92
    });
    
    carousel.onScroll = () => {
      if (progressBar) {
        // Bar is 1/slideCount wide, so max left position is (slideCount-1)/slideCount
        const maxLeft = 100 - (100 / slideCount);
        progressBar.style.left = `${maxLeft * carousel.progress}%`;
      }
    };
  }
});
</script>