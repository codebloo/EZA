<section class="pdp-quality-blocks">
    <div class="section section--page-width">
         <h2 class="quality-blocks-title">{{ section.settings.title }}</h2>
        <div class="all-quality-blocks">
 
  {% content_for 'blocks' %}
  </div>
</div>
</section>
{% schema %}
{
  "name": "EZ-A PDP Quality",
  "class": "section-wrapper",
  "settings": [{
"type": "text",
"id":"title",
"label": "Title"}],
  "blocks": [
    {
      "type": "_quality"
    },
  ],
  "disabled_on": {
    "groups": ["header"]
  },
    "presets": [
    {
      "name": "EZ-A PDP Quality",
    }
  ]
}
{% endschema %}
