<section class="pdp-trust-blocks">
    {{ 'pdp-trust-blocks.css' | asset_url | stylesheet_tag }}
    <div class="section section--page-width">

        <div class="all-trust-blocks"> 
            {% for block in section.blocks %}
                <div class="trust-block">
                   {%- if block.settings.image != blank -%}
  {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: alt: block.settings.image.alt }}
{%- endif -%}
                    <div class="trust-title"><span>{{ block.settings.title }}</span></div>
                    <div class="trust-text">{{ block.settings.text }}</div>
                </div>
            {% endfor %}
            </div>
    </div>
</section>
{% schema %}
{
  "name": "EZ-A PDP Trust",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "trust",
      "name":"Trust Block",
      "settings": [
          {
      "type": "image_picker",
      "id": "image",
      "label": "Image"},
        {
      "type": "text",
      "id": "title",
      "label": "Title"},
          {
      "type": "textarea",
      "id": "text",
      "label": "Text"}
      ]
    },
  ],
  "disabled_on": {
    "groups": ["header"]
  },
    "presets": [
    {
      "name": "EZ-A PDP Trust",
    }
  ]
}
{% endschema %}
