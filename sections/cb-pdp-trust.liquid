<section class="pdp-trust-blocks">
    {{ 'pdp-trust-blocks.css' | asset_url | stylesheet_tag }}
    <div class="section section--page-width">

        <div class="all-trust-blocks"> 
            {% for block in section.blocks %}
                <div class="trust-block">
           
  {% render 'icon-or-image',
    icon: block_settings.icon,
    image_upload: block_settings.image,
    width: block_settings.width,
    class_name: icon_block_class,
    attributes: block.shopify_attributes
  %}

                    <div class="trust-title"><span>{{ block.settings.title }}</span></div>
                    <div class="trust-text">{{ block.settings.text }}</div>
                </div>
            {% endfor %}
            </div>
    </div>
</section>
{% schema %}
{
  "name": "EZ-A PDP Trust",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "trust",
      "name":"Trust Block",
      "settings": [
          {
      "type": "image_picker",
      "id": "image",
      "label": "Image"},
       {
      "type": "range",
      "id": "width",
      "label": "t:settings.width",
      "min": 12,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 24
    },
        {
      "type": "text",
      "id": "title",
      "label": "Title"},
          {
      "type": "textarea",
      "id": "text",
      "label": "Text"}
      ]
    },
  ],
  "disabled_on": {
    "groups": ["header"]
  },
    "presets": [
    {
      "name": "EZ-A PDP Trust",
    }
  ]
}
{% endschema %}
