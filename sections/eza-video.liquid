          </span>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 class="eza-video-hero__heading cta-desktop">{{ heading }}</h2>
        {%- endif -%}

        {%- if cta_text != blank -%}
          <span class="eza-video-hero__cta">{{ cta_text }}</span>
        {%- endif -%}
      </div>
    </div>

      {%- if heading != blank -%}
          <h2 class="eza-video-hero__heading cta-mobile">{{ heading }}</h2>
        {%- endif -%}
  </button>

</section>

<script>
  (function () {
    var section = document.getElementById('eza-video-hero-{{ section.id }}');
    if (!section) return;

    var trigger = section.querySelector('.eza-video-hero__trigger');
    if (!trigger) return;

    function getYouTubeId(url) {
      if (!url) return null;
      var patterns = [
        /(?:youtube\.com\/watch\?(?:.*&)?v=)([\w-]{11})/,
        /(?:youtu\.be\/)([\w-]{11})/,
        /(?:youtube\.com\/embed\/)([\w-]{11})/,
        /(?:youtube\.com\/shorts\/)([\w-]{11})/,
        /(?:youtube\.com\/v\/)([\w-]{11})/
      ];
      for (var i = 0; i < patterns.length; i++) {
        var m = url.match(patterns[i]);
        if (m && m[1]) return m[1];
      }
      // Fallback: assume the value itself is an 11-char ID
      if (/^[\w-]{11}$/.test(url.trim())) return url.trim();
      return null;
    }

    var lastFocused = null;
    var modal = null;

    function openModal() {
      var url = trigger.getAttribute('data-video-url');
      var videoId = getYouTubeId(url);
      if (!videoId) {
        console.warn('[eza-video-hero] Could not parse YouTube URL:', url);
        return;
      }

      lastFocused = document.activeElement;

      modal = document.createElement('div');
      modal.className = 'eza-video-modal';
      modal.setAttribute('role', 'dialog');
      modal.setAttribute('aria-modal', 'true');
      modal.setAttribute('aria-label', trigger.getAttribute('aria-label') || 'Video player');
      modal.innerHTML = [
        '<div class="eza-video-modal__inner">',
          '<button type="button" class="eza-video-modal__close" aria-label="Close video">',
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">',
              '<line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>',
            '</svg>',
          '</button>',
          '<iframe',
            ' src="https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0&playsinline=1"',
            ' title="YouTube video"',
            ' allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"',
            ' allowfullscreen></iframe>',
        '</div>'
      ].join('');

      document.body.appendChild(modal);
      document.body.classList.add('eza-modal-open');

      requestAnimationFrame(function () {
        modal.setAttribute('data-open', 'true');
      });

      var closeBtn = modal.querySelector('.eza-video-modal__close');
      closeBtn.focus();

      modal.addEventListener('click', function (e) {
        if (e.target === modal) closeModal();
      });
      closeBtn.addEventListener('click', closeModal);
      document.addEventListener('keydown', onKeydown);
    }

    function closeModal() {
      if (!modal) return;
      document.removeEventListener('keydown', onKeydown);
      document.body.classList.remove('eza-modal-open');
      if (modal.parentNode) modal.parentNode.removeChild(modal);
      modal = null;
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
    }

    function onKeydown(e) {
      if (e.key === 'Escape' || e.keyCode === 27) closeModal();
    }

    trigger.addEventListener('click', openModal);
  })();
</script>

{% schema %}
{
  "name": "EZ-A  Video hero",
  "tag": "section",
  "class": "section-video-hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Hero image (mobile)",
      "info": "Optional. Falls back to desktop image if empty."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height (desktop)",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height (mobile)",
      "min": 200,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_play_button",
      "label": "Show play button icon",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Warning: Contains actual science, one extra annoyed fairy, and zero bullsh*t."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Watch the Video Now"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading colour",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "CTA colour",
      "default": "#F2C94C"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "YouTube URL",
      "info": "Paste a full YouTube URL — supports watch, youtu.be, embed, and shorts formats."
    }
  ],
  "presets": [
    {
      "name": "EZ-A Video hero"
    }
  ]
}
{% endschema %}
