{%- liquid
  assign image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign min_height_desktop = section.settings.min_height_desktop
  assign min_height_mobile = section.settings.min_height_mobile
  assign heading = section.settings.heading
  assign cta_text = section.settings.cta_text
  assign video_url = section.settings.video_url
  assign show_play_button = section.settings.show_play_button

  assign aria_label = 'Play video'
  if heading != blank
    assign aria_label = 'Play video: ' | append: heading
  endif
-%}

<style>
  #eza-video-hero-{{ section.id }} {
    --eza-overlay-opacity: {{ overlay_opacity }};
    --eza-min-height-desktop: {{ min_height_desktop }}px;
    --eza-min-height-mobile: {{ min_height_mobile }}px;
    --eza-text-color: {{ section.settings.text_color }};
    --eza-cta-color: {{ section.settings.cta_color }};
    padding: 32px 0;
    position: relative;
  }

  .eza-video-hero__trigger {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0 auto;
    width: calc(100% - 48px);
    display: block;
    position: relative;
    cursor: pointer;
    color: var(--eza-text-color);
    font: inherit;
    text-align: center;
    aspect-ratio: 16/9;
    height: var(--eza-min-height-mobile);
  }

  .eza-video-hero__media-wrap {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding:0;
  }

  @media (min-width: 750px) {
#eza-video-hero-{{ section.id }} {padding:32px 0 64px 0;}
    .eza-video-hero__media-wrap { 
         margin: 0 auto;
        max-width: 100%;
         min-height: var(--eza-min-height-desktop);
        width: 1136px;}

  }

  .eza-video-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .eza-video-hero__image--mobile { 
     border-radius:16px;
    display: block; }
  .eza-video-hero__image--desktop { display: none; }

    .eza-video-hero__play svg {
       height: 57px;
      width: 57px;
  }
  .cta-mobile { display: block; }
.cta-desktop { display: none; }

  @media (min-width: 750px) {
    .eza-video-hero__image--mobile,
    .cta-mobile { display: none; }
    .eza-video-hero__image--desktop { 
        border-radius:16px;
        display: block; }
        .cta-desktop { display: block; }

  .eza-video-hero__play svg {
       height: 64px;
      width: 64px;
  }

      .eza-video-hero__trigger {  height: var(--eza-min-height-desktop);}

  }

  .eza-video-hero__overlay {
    border-radius:16px;
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--eza-overlay-opacity));
    z-index: 1;
    pointer-events: none;
  }

  .eza-video-hero__content {
    position: relative;
    z-index: 2;
    padding: 4rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 90%;
    margin: 0 auto;
  }

  .eza-video-hero__play {
    align-items: center;
     border-radius: 50%;
    display: flex;
    height: 64px;
    justify-content: center;
    transition: transform 200ms ease, background-color 200ms ease;
    width: 64px;
  }

  .eza-video-hero__trigger:hover .eza-video-hero__play,
  .eza-video-hero__trigger:focus-visible .eza-video-hero__play {
    transform: scale(1.08);
  }


  .eza-video-hero__heading {
    color:#343434;
    font-size: 24px;
    font-weight: 700;
    margin: 0;
    line-height: 1.25;
    padding:16px 24px 0;
      text-transform: initial;
  }



  .eza-video-hero__cta {
    color: var(--eza-cta-color);
    font-weight: 600;
    text-decoration: none;
    text-underline-offset: 4px;
    font-size: 1.125rem;
      text-transform: initial;
  }

  .eza-video-hero__trigger:focus-visible {
    outline: 3px solid var(--eza-cta-color);
    outline-offset: -3px;
  }

  /* Modal */
  .eza-video-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .eza-video-modal[data-open="true"] { opacity: 1; }

  .eza-video-modal__inner {
    height:100%;
    position: relative;
    width: 100%;
    max-width: 1200px;
  }

  .eza-video-modal__inner iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .eza-video-modal__close {
    position: absolute;
    top: -3rem;
    right: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 150ms ease;
  }

  .eza-video-modal__close:hover,
  .eza-video-modal__close:focus-visible {
    background: rgba(255, 255, 255, 0.2);
  }

  .eza-video-modal__close svg { width: 18px; height: 18px; }

  body.eza-modal-open { overflow: hidden; }

  @media (min-width:750px){
    .eza-video-hero__heading {
    color:#fff;
    font-size: 36px;
    margin:0 auto;
    max-width:100%;
    padding:unset;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.4);
    text-transform: initial;
    width:700px;
  }

    .eza-video-hero__cta {font-size:24px;}

    .eza-video-hero__media-wrap{align-items:end;}
    ..eza-video-hero__content{padding-bottom:42px;}
}
 
</style>

<section
  id="eza-video-hero-{{ section.id }}"
  class="eza-video-hero"
  data-section-id="{{ section.id }}"
>
  <button
    type="button"
    class="eza-video-hero__trigger"
    data-video-url="{{ video_url | escape }}"
    aria-label="{{ aria_label | escape }}"
  >
    <div class="eza-video-hero__media-wrap">
      {%- if image != blank -%}
        {%- if mobile_image != blank -%}
          {{ mobile_image | image_url: width: 1200 | image_tag:
            class: 'eza-video-hero__image eza-video-hero__image--mobile',
            widths: '375, 550, 750, 1100, 1500',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: image.alt | default: heading
          }}
          {{ image | image_url: width: 2400 | image_tag:
            class: 'eza-video-hero__image eza-video-hero__image--desktop',
            widths: '750, 1100, 1500, 1800, 2200, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: image.alt | default: heading
          }}
        {%- else -%}
          {{ image | image_url: width: 2400 | image_tag:
            class: 'eza-video-hero__image',
            widths: '375, 550, 750, 1100, 1500, 1800, 2200, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: image.alt | default: heading
          }}
        {%- endif -%}
      {%- endif -%}

      <div class="eza-video-hero__overlay"></div>

      <div class="eza-video-hero__content">
        {%- if show_play_button -%}
          <span class="eza-video-hero__play" aria-hidden="true">
           
<svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
