{%- comment -%}
  ============================================================
  Section: EZ-A Scroll Testimonials
  ------------------------------------------------------------
  - Desktop (≥750px): N-up grid (configurable columns)
  - Mobile (<750px):  Drag-scroll carousel with scroll-snap
                      and a FULL-WIDTH progress bar
  - Section width:    page-width or full-width (per setting)
  - Block-based:      merchants add/edit/reorder testimonials
  ============================================================
{%- endcomment -%}

{%- liquid
  assign section_width = section.settings.section_width | default: 'page-width'
  if section_width == 'page-width'
    assign inner_class = 'page-width'
  else
    assign inner_class = ''
  endif
-%}

<section
  class="section-testimonials testimonials color-{{ section.settings.color_scheme | default: 'background-1' }} section section--{{ section_width }}"
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
  data-testimonials="{{ section.id }}"
  style="
    --card-bg: {{ section.settings.card_bg }};
    --card-text: {{ section.settings.text_color }};
    --star-color: {{ section.settings.star_color }};
    --columns: {{ section.settings.columns_desktop }};
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
  "
>
  {%- if section.settings.heading != blank -%}
    <div class="testimonials__inner{{ inner_class }}">
      <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="testimonials__inner testimonials__inner--track {{ inner_class }}">
      <div class="testimonials__track" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            <article
              class="testimonials__card"
              role="listitem"
              {{ block.shopify_attributes }}
            >
              <div class="testimonials_head">
              {%- assign rating = block.settings.rating | default: 5 -%}
              <div
                class="testimonials__stars"
                aria-label="{{ rating }} out of 5 stars"
              >
                {%- for i in (1..rating) -%}
                  <svg
                    class="testimonials__star"
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {%- endfor -%}
              </div>

              {%- if block.settings.quote != blank -%}
                <p class="testimonials__quote">{{ block.settings.quote }}</p>
              {%- endif -%}
</div>
              <div class="testimonials__attribution">
                {%- if block.settings.name != blank -%}
                  <p class="testimonials__name">{{ block.settings.name }}</p>
                {%- endif -%}
                {%- if block.settings.subtitle != blank -%}
                  <p class="testimonials__subtitle">{{ block.settings.subtitle }}</p>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%}
      Progress bar lives OUTSIDE any inner wrapper so it always
      spans the section's full width (= viewport width on mobile,
      where it's actually visible).
    {%- endcomment -%}
    <div class="testimonials__progress" aria-hidden="true">
      <div class="testimonials__progress-bar"></div>
    </div>
  {%- endif -%}

  {%- if section.settings.link_text != blank -%}
    <div class="testimonials__inner {{ inner_class }}">
      <div class="testimonials__cta">
        <a
          href="{{ section.settings.link_url | default: '#' }}"
          class="testimonials__link"
        >
          {{ section.settings.link_text }}
         <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M7.99621 16C6.90077 16 5.87096 15.7904 4.90677 15.3712C3.94258 14.9571 3.09197 14.3813 2.35495 13.6439C1.61792 12.9116 1.03991 12.0631 0.620918 11.0985C0.206973 10.1338 0 9.10101 0 8C0 6.90404 0.206973 5.87374 0.620918 4.90909C1.03991 3.94444 1.6154 3.09343 2.34737 2.35606C3.0844 1.61869 3.93501 1.04293 4.8992 0.628788C5.86843 0.209596 6.90077 0 7.99621 0C9.09165 0 10.1215 0.209596 11.0857 0.628788C12.0549 1.04293 12.9055 1.61869 13.6375 2.35606C14.3745 3.09343 14.9525 3.94444 15.3715 4.90909C15.7905 5.87374 16 6.90404 16 8C16 9.10101 15.7905 10.1338 15.3715 11.0985C14.9525 12.0631 14.3745 12.9116 13.6375 13.6439C12.9055 14.3813 12.0574 14.9571 11.0932 15.3712C10.129 15.7904 9.0967 16 7.99621 16ZM12.1533 7.99242C12.1533 7.7096 12.0423 7.46465 11.8202 7.25758L9.10932 4.65152C8.93769 4.4899 8.73576 4.40909 8.50355 4.40909C8.28143 4.40909 8.0997 4.48232 7.95835 4.62879C7.81701 4.77525 7.74633 4.96465 7.74633 5.19697C7.74633 5.42424 7.83467 5.61869 8.01136 5.7803L8.8973 6.59091L9.69995 7.18182L8.14009 7.08333H4.68717C4.43982 7.08333 4.23537 7.17172 4.07383 7.34848C3.91229 7.5202 3.83152 7.73485 3.83152 7.99242C3.83152 8.25 3.91229 8.46717 4.07383 8.64394C4.23537 8.81566 4.43982 8.90152 4.68717 8.90152H8.14009L9.69995 8.81061L8.92002 9.39394L8.01136 10.2121C7.83467 10.3586 7.74633 10.553 7.74633 10.7955C7.74633 11.0278 7.81701 11.2197 7.95835 11.3712C8.0997 11.5177 8.28143 11.5909 8.50355 11.5909C8.73071 11.5909 8.93264 11.5076 9.10932 11.3409L11.8202 8.73485C12.0423 8.52778 12.1533 8.2803 12.1533 7.99242Z" fill="#0000EE"/>
</svg>

        </a>
      </div>
    </div>
  {%- endif -%}
</section>

<style>
  .testimonials {
    padding-top: var(--pt, 60px);
    padding-bottom: var(--pb, 60px);
  }

  /* Inner wrappers stay unstyled at the block level — width and
     horizontal padding come from the theme's .page-width class
     when applied. Full-width mode = no .page-width, no constraint. */

  .testimonials__heading {
    text-align: center;
    margin: 0 0 2.5rem;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
  }

  /* ---------- Desktop: grid ---------- */
  .testimonials__track {
    display: grid;
    grid-template-columns: repeat(var(--columns, 3), 1fr);
    gap: 1.25rem;
  }

  .testimonials__card {
    background: var(--card-bg, #f1f1f1);
    color: var(--card-text, #1a1a1a);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .testimonials__stars {
    display: flex;
    gap: 1px;
    color: var(--star-color, #f5c518);
    margin-bottom:0;
  }

  .testimonials__quote {
   color: var(--text_color, #000);
   flex: 1;
  font-size: 16px;
  font-style: italic;
  font-weight: 400;
  line-height: 21px; 
    margin: 0;
}

  .testimonials__attribution {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonials__name {
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    margin: 0;}

  .testimonials__subtitle {
    font-size: 16px; 
    font-weight: 300;
    line-height: 1;
    margin: 0;}

  /* ---------- Progress bar (mobile only, full section width) ---------- */
  .testimonials__progress {
    display: none;
    position: relative;
    height: 2px;
    background: rgba(0, 0, 0, 0.08);
    margin: 1.25rem 0 0;
    overflow: hidden;
  }

  .testimonials__progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: currentColor;
    transition: transform 0.05s linear, width 0.05s linear;
  }

  /* ---------- CTA link ---------- */
  .testimonials__cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  .testimonials__link {
align-items: center;
border-radius: 8px;
border: 2px solid #D3D3D3;
   color: var(--blue);
display: inline-flex;  
font-size: 13px;  
font-weight: 700;
gap: 10px;
height: 48px;
justify-content: center;
letter-spacing: 0.65px;
line-height: 1;
padding: 12px 24px;
    text-decoration: none;
 text-transform: uppercase;
  transition: opacity 0.2s ease;}

  .testimonials__link:hover {
    opacity: 0.65;
  }

  /* ============================================================
     Mobile: drag-scroll carousel with scroll-snap
     ============================================================ */
  @media (max-width: 749px) {
    /* Track wrapper drops its constraints so cards can bleed
       to the viewport edges. Track itself supplies the gutter. */
    .testimonials__inner--track {
      padding-left: 0;
      padding-right: 0;
      max-width: none;
    }

    .testimonials__track {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 0 1.5rem;
      gap: 0.75rem;
      scroll-padding-left: 1.5rem;
    }

    .testimonials__track::-webkit-scrollbar {
      display: none;
    }

    .testimonials__card {
      flex: 0 0 85%;
      scroll-snap-align: start;
    }

    .testimonials__progress {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials__progress-bar {
      transition: none;
    }
  }

  @media (min-width:750px){
.testimonials__inner--track {
    margin:0 auto;
    max-width:100%;
    padding:0 24px;
    width:1080px;}
}
</style>

<script>
  (function () {
    var section = document.querySelector('[data-testimonials="{{ section.id }}"]');
    if (!section) return;

    var track = section.querySelector('.testimonials__track');
    var bar = section.querySelector('.testimonials__progress-bar');
    if (!track || !bar) return;

    function update() {
      var scrollWidth = track.scrollWidth;
      var clientWidth = track.clientWidth;
      if (scrollWidth <= clientWidth) {
        bar.style.width = '100%';
        bar.style.transform = 'translateX(0)';
        return;
      }
      var widthPct = (clientWidth / scrollWidth) * 100;
      var maxScroll = scrollWidth - clientWidth;
      var progressPct = (track.scrollLeft / maxScroll) * (100 - widthPct);
      bar.style.width = widthPct + '%';
      bar.style.transform = 'translateX(' + (progressPct / widthPct * 100) + '%)';
    }

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);

    update();
    if (document.readyState === 'complete') {
      requestAnimationFrame(update);
    } else {
      window.addEventListener('load', update);
    }
  })();
</script>

{% schema %}
{
  "name": "EZ-A Scroll Testimonials",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Lot of People Love Us"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#EFEFEF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card text colour",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": "#F5C518"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section colour scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "info": "Leave blank to hide",
      "default": "Read all the reviews"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 12,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I go from daydreaming to actually getting work done. It's not magic. It just works."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Marcus R."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EZ-A Scroll Testimonials",
      "blocks": [
        { "type": "testimonial" },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Smooth, consistent energy and mental clarity. No jitters, no crash—easy 10+ hours.",
            "name": "Jenna K."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "I went from daydreaming at my desk to locked in for four hours. Finished more in one afternoon than I had all week.",
            "name": "Marcus R."
          }
        }
      ]
    }
  ]
}
{% endschema %}
