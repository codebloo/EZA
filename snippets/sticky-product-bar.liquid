{%- comment -%}
  snippets/sticky-product-bar.liquid

  Mobile sticky condensed product header for EZ-A (Horizon theme).

  Usage (in main-product.liquid):
    {% render 'sticky-product-bar', product: product %}

  The snippet auto-repositions to be the first child of .product-information
  via JS, so it can render anywhere inside the section and still work.
{%- endcomment -%}

{{ 'eza-sticky-product-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sticky-product-bar.js' | asset_url }}" defer></script>

<sticky-product-bar
  class="sticky-product-bar"
  data-header-offset-var="--header-group-height"
  data-header-selector="#header-component"
  data-atc-selector="variant-picker"
>
  {%- comment -%} Sentinel sits 1px above the sticky boundary — observed for stuck state {%- endcomment -%}
  <span class="sticky-product-bar__sentinel" aria-hidden="true"></span>

  <div class="sticky-product-bar__inner">
    <div class="sticky-product-bar__content">
      {%- comment -%}
        TODO: Replace with the actual Yotpo star-rating widget block
        (currently rendered inline as instance 842520) so the rating/count
        stays in sync with the inline widget. The placeholder below uses
        product metafields as a fallback.
      {%- endcomment -%}
      <a href="#yotpo-reviews-main-widget" class="sticky-product-bar__reviews">
        <span class="sticky-product-bar__stars" aria-hidden="true">★★★★★</span>
        <span class="sticky-product-bar__rating">
          {{- product.metafields.reviews.rating.value | default: '4.7' }} Stars
        </span>
        <span class="sticky-product-bar__separator" aria-hidden="true">·</span>
        <span class="sticky-product-bar__count">
          {{- product.metafields.reviews.rating_count | default: '70' }} Reviews
        </span>
      </a>

      <p class="sticky-product-bar__title">{{ product.title }}</p>
    </div>

    <button
      type="button"
      class="sticky-product-bar__cta"
      data-shop-now
      aria-hidden="true"
      tabindex="-1"
    >
      Shop Now
    </button>
  </div>
</sticky-product-bar>