{%- comment -%}
  snippets/sticky-product-bar.liquid

  Mobile sticky condensed product header for Horizon PDP.
  Drop in your review-provider markup where noted.

  Usage (in main-product.liquid or a block):
    {% render 'sticky-product-bar', product: product %}
{%- endcomment -%}

{{ 'eza-sticky-product-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sticky-product-bar.js' | asset_url }}" defer></script>

<sticky-product-bar
  class="sticky-product-bar"
  data-atc-selector="[ref='addToCartButton'], product-form-component button[name='add'], .product-form__submit"
>
  {%- comment -%} Sentinel sits 1px above the sticky boundary — observed for stuck state {%- endcomment -%}
  <span class="sticky-product-bar__sentinel" aria-hidden="true"></span>

  <div class="sticky-product-bar__inner">
    <div class="sticky-product-bar__content">
      {%- comment -%}
        Replace this block with your review-provider markup
        (Okendo, Yotpo, Judge.me, etc.) — keep the wrapping <a> for the
        click-through to the reviews anchor and the same class names so
        the condensed scaling still applies.
      {%- endcomment -%}
      <a href="#reviews" class="sticky-product-bar__reviews">
        <span class="sticky-product-bar__stars" aria-hidden="true">★★★★★</span>
        <span class="sticky-product-bar__rating">
          {{- product.metafields.reviews.rating.value | default: '4.7' }} Stars
        </span>
        <span class="sticky-product-bar__separator" aria-hidden="true">·</span>
        <span class="sticky-product-bar__count">
          {{- product.metafields.reviews.rating_count | default: '120' }} Reviews
        </span>
      </a>

      {%- comment -%}
        Use h1 here only if you remove/hide the title in the main product
        info block on mobile. Otherwise keep this as a styled <p> or <span>
        to avoid duplicate H1s.
      {%- endcomment -%}
      <p class="sticky-product-bar__title">{{ product.title }}</p>
    </div>

    <button
      type="button"
      class="sticky-product-bar__cta"
      data-shop-now
      aria-hidden="true"
      tabindex="-1"
    >
      Shop Now
    </button>
  </div>
</sticky-product-bar>