{% comment %}
  snippets/subscription-selector.liquid
  
  One-time / Subscribe & Save selector with inline ATC button.
  ATC lives inside the active option's expanded panel.
{% endcomment %}

{%- if product.selling_plan_groups.size > 0 -%}
  {%- assign initial_variant = product.selected_or_first_available_variant -%}
  {%- assign initial_allocation = initial_variant.selling_plan_allocations | first -%}
  {%- assign initial_savings = 0 -%}
  {%- if initial_allocation and initial_variant.price > 0 -%}
    {%- assign initial_savings = initial_variant.price | minus: initial_allocation.price | times: 100.0 | divided_by: initial_variant.price | round: 0 -%}
  {%- endif -%}

  <subscription-selector class="vpv-sub-selector" {% if block %}{{ block.shopify_attributes }}{% endif %}>
    <script type="application/json" data-variant-data>
    {
      {%- for variant in product.variants -%}
        "{{ variant.id }}": {
          "price_formatted": {{ variant.price | money | json }},
          "plans": [
            {%- for allocation in variant.selling_plan_allocations -%}
              {
                "id": {{ allocation.selling_plan.id }},
                "name": {{ allocation.selling_plan.name | json }},
                "price_formatted": {{ allocation.price | money | json }},
                "savings_percent": {%- if variant.price > 0 -%}{{ variant.price | minus: allocation.price | times: 100.0 | divided_by: variant.price | round: 0 }}{%- else -%}0{%- endif -%}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
    </script>

    {%- comment -%} One-time {%- endcomment -%}
    <div class="vpv-sub-selector__option">
      <label class="vpv-sub-selector__row">
        <input type="radio" name="selling_plan" value="" checked>
        <span class="vpv-sub-selector__info">
          <span class="vpv-sub-selector__title">One-time Purchase</span>
          <span class="vpv-sub-selector__price" data-onetime-price>{{ initial_variant.price | money }}</span>
        </span>
        <span class="vpv-sub-selector__radio-icon" aria-hidden="true"></span>
      </label>
      <div class="vpv-sub-selector__expanded">
        <button type="submit" class="vpv-sub-selector__atc">
          Add to Cart — <span data-onetime-price>{{ initial_variant.price | money }}</span>
        </button>
      </div>
    </div>

    {%- comment -%} Subscribe & Save {%- endcomment -%}
    <div class="vpv-sub-selector__option">
      <label class="vpv-sub-selector__row">
        <input type="radio" name="selling_plan" value="{{ initial_allocation.selling_plan.id }}" data-sub-radio>
        <span class="vpv-sub-selector__info">
          <span class="vpv-sub-selector__title">
            Subscribe &amp; Save
            <span class="vpv-sub-selector__badge" data-savings-badge>Save {{ initial_savings }}%</span>
          </span>
          <span class="vpv-sub-selector__price">
            <strong data-sub-price>{{ initial_allocation.price | money }}</strong>
            <s data-strikethrough-price>{{ initial_variant.price | money }}</s>
          </span>
        </span>
        <span class="vpv-sub-selector__radio-icon" aria-hidden="true"></span>
      </label>
      <div class="vpv-sub-selector__expanded">
        <p class="vpv-sub-selector__benefits">
          Free Shipping · Cancel Anytime · <span data-savings-text>{{ initial_savings }}% off</span> Every Order
        </p>
        <select class="vpv-sub-selector__frequency" data-frequency-select aria-label="Delivery frequency">
          {%- for allocation in initial_variant.selling_plan_allocations -%}
            {%- assign plan_savings = 0 -%}
            {%- if initial_variant.price > 0 -%}
              {%- assign plan_savings = initial_variant.price | minus: allocation.price | times: 100.0 | divided_by: initial_variant.price | round: 0 -%}
            {%- endif -%}
            <option value="{{ allocation.selling_plan.id }}"
                    data-price="{{ allocation.price | money }}"
                    data-savings="{{ plan_savings }}">
              {{ allocation.selling_plan.name }}
            </option>
          {%- endfor -%}
        </select>
        <button type="submit" class="vpv-sub-selector__atc">
          Add to Cart — <span data-sub-price>{{ initial_allocation.price | money }}</span>
        </button>
      </div>
    </div>
  </subscription-selector>

  <script>
    if (!customElements.get('subscription-selector')) {
      customElements.define('subscription-selector', class extends HTMLElement {
        connectedCallback() {
          this.form = this.closest('form[action*="/cart/add"]');
          this.subRadio = this.querySelector('[data-sub-radio]');
          this.frequencySelect = this.querySelector('[data-frequency-select]');

          try {
            this.variantData = JSON.parse(this.querySelector('[data-variant-data]').textContent);
          } catch (e) {
            console.warn('[subscription-selector] Bad JSON', e);
            return;
          }

          if (!this.form) {
            console.warn('[subscription-selector] Not inside a /cart/add form');
            return;
          }

          this.frequencySelect?.addEventListener('change', () => this.syncFromFrequency());

          // Variant change detection
          this.form.addEventListener('change', (e) => {
            if (e.target.name === 'id') this.renderForVariant(e.target.value);
          });
          document.addEventListener('variant:change', (e) => {
            const v = e.detail?.variant;
            if (v?.id) this.renderForVariant(v.id);
          });
          const idInput = this.form.querySelector('[name="id"]');
          if (idInput) {
            this.observer = new MutationObserver(() => this.renderForVariant(idInput.value));
            this.observer.observe(idInput, { attributes: true, attributeFilter: ['value'] });
          }
        }

        disconnectedCallback() {
          this.observer?.disconnect();
        }

        syncFromFrequency() {
          const opt = this.frequencySelect.selectedOptions[0];
          if (!opt || !this.subRadio) return;

          this.subRadio.value = opt.value;

          this.querySelectorAll('[data-sub-price]').forEach(el => {
            el.textContent = opt.dataset.price;
          });

          const savings = parseInt(opt.dataset.savings, 10) || 0;
          this.querySelectorAll('[data-savings-badge]').forEach(el => {
            el.textContent = `Save ${savings}%`;
            el.style.display = savings > 0 ? '' : 'none';
          });
          this.querySelectorAll('[data-savings-text]').forEach(el => {
            el.textContent = `${savings}% off`;
          });
        }

        renderForVariant(variantId) {
          const data = this.variantData[variantId];
          if (!data) return;

          this.querySelectorAll('[data-onetime-price], [data-strikethrough-price]').forEach(el => {
            el.textContent = data.price_formatted;
          });

          if (this.frequencySelect && data.plans.length > 0) {
            this.frequencySelect.innerHTML = data.plans.map(p => `
              <option value="${p.id}" data-price="${p.price_formatted}" data-savings="${p.savings_percent}">${this.escape(p.name)}</option>
            `).join('');
            this.syncFromFrequency();
          }
        }

        escape(str) {
          const d = document.createElement('div');
          d.textContent = str;
          return d.innerHTML;
        }
      });
    }
  </script>
{%- endif -%}